# Copy to app/.env. Values come from Supabase dashboard → Project Settings → API.
# The publishable key is safe in the app (RLS protects the data). Never put
# secret/service-role keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
